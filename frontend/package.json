      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/google-maps": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@deck.gl/core": "^9.2.11",
    "@deck.gl/google-maps": "^9.2.11",
    "@deck.gl/layers": "^9.2.11",
    "@jsverse/transloco": "^7.6.1",
    "@tailwindcss/postcss": "^4.1.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/google.maps": "^3.64.0",
    "@types/node": "^25.0.0",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.0.50",
    "jsdom": "^25.0.1",
    "postcss": "8.5.10",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.6"
  }
